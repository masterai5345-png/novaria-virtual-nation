# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — configure only after creating a Google OAuth Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Database — add a managed PostgreSQL URL before enabling persistent citizen accounts
DATABASE_URL=

# AI provider — keep secret on the server; never expose in NEXT_PUBLIC_ variables
ANTHROPIC_API_KEY=

# Social integrations — configure only with approved official API access
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Monetization integrations — disabled until publisher approval and legal review
OFFERWALL_ENABLED=false
OFFERWALL_PUBLISHER_ID=
OFFERWALL_POSTBACK_SECRET=
