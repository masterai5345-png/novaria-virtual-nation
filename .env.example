# Application URL (set by your host after deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NOVARIA_OWNER_EMAIL=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Managed PostgreSQL (same database URL on web and worker)
DATABASE_URL=
DB_POOL_MAX=10

# Signed webhook secret for an approved official YouTube/Meta metrics connector (server only)
AUDIENCE_INGEST_SECRET=

# Claude worker only; keep all keys server-side
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
WORKER_POLL_MS=5000

# Social integrations — not implemented yet; use official approved APIs only
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Monetization — disabled; never enable until provider approval and legal review
OFFERWALL_ENABLED=false
OFFERWALL_PUBLISHER_ID=
OFFERWALL_POSTBACK_SECRET=

# Signed webhook secret for an approved official social-comment connector (server only)
SOCIAL_INGEST_SECRET=
